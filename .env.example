# ==============================================================================
# IPL Nexus — Environment Variables Template
# Copy this file to .env and configure for your environment
# ==============================================================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# DuckDB Warehouse Path (relative or absolute)
DUCKDB_PATH=data/ipl_nexus.duckdb

# Machine Learning Model Artifact Path
MODEL_PATH=ml/models/calibrated_win_model.joblib

# Frontend Configuration (for Vite)
# In development: defaults to http://localhost:8000/api
# In production / Docker Compose: defaults to /api (proxied via Nginx)
# In separate cloud hosts (e.g. Vercel frontend + Render backend):
VITE_API_BASE_URL=http://localhost:8000/api
